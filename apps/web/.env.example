# Laravel API base URL (no trailing slash). Used by Server Components and future client calls.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Closed beta banner on the public site
NEXT_PUBLIC_CLOSED_BETA=false

# Sentry (optional locally; set in staging/production)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# SENTRY_ENVIRONMENT=local
