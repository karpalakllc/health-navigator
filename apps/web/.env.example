# Laravel API base URL (no trailing slash). Used by Server Components and future client calls.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public origin of this app. Required in production for canonical URLs,
# OpenGraph tags, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Object-storage media base (same value as the API's AWS_URL). Leave unset when
# media is served by the API itself (MEDIA_DISK=public, the local default).
# NEXT_PUBLIC_MEDIA_URL=https://media.example.com

# Server-only (never NEXT_PUBLIC_). Same value as the API's WEB_TIER_SECRET; lets
# the API trust the visitor address this server forwards. Optional locally.
# WEB_TIER_SECRET=
# Extra hostnames allowed to POST to /api/* route handlers (apex + www, aliases).
# ALLOWED_ORIGINS=

# Closed beta banner on the public site
NEXT_PUBLIC_CLOSED_BETA=false

# Sentry (optional locally; set in staging/production)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# SENTRY_ENVIRONMENT=local

# Header your edge writes the real client address into, if it is not
# x-forwarded-for. Leave unset unless you know the edge overwrites it —
# an un-overwritten header is just caller-supplied input.
# CLIENT_IP_HEADER=cf-connecting-ip

# Anonymous UX statistics (docs/ux-heatmaps.md): share of tabs tracked, 0–1.
# Unset = every tab; 0 switches the tracker off.
# NEXT_PUBLIC_UX_SAMPLE_RATE=1
