# Larastan (PHPStan + Laravel rules). Run from apps/api:
#
#   ./vendor/bin/phpstan analyse --memory-limit=1G
#
# phpstan-baseline.neon records the errors that existed when the analyser was
# introduced. CI fails on anything not in it, so new and changed code must pass
# level 5 outright. Fix a baselined error when you touch its code, then shrink
# the baseline (docs/pr-verification.md "Static analysis"); never regenerate it
# to absorb a new error.

includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
    # A baselined error that no longer occurs fails the run, so fixes shrink
    # the baseline instead of leaving dead entries behind.
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Pre-existing, and kept out of the baseline on purpose: PHPStan counts
        # this trait error once under the trait and again under ForumPost.php
        # ("in context of class"), but --generate-baseline records it once, so
        # a regenerated baseline would fail its own run. Larastan reads `status`
        # as the column's string, not the enum cast; fix both when the models
        # get @property annotations, then delete this entry.
        -
            message: '#^Strict comparison using \=\=\= between string and App\\Enums\\ForumContentStatus\:\:Approved will always evaluate to false\.$#'
            identifier: identical.alwaysFalse
            paths:
                - app/Models/ForumPost.php
                - app/Models/Concerns/ModeratesForumContent.php
