APP_NAME=Zdravje360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Public media uploads (logo, avatars) — local: public disk under storage/app/public/media
MEDIA_DISK=public
MEDIA_DIRECTORY=media

# Public Next.js app — Filament "View on site" and transactional email links
WEB_PUBLIC_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (project standard — not SQLite for local app data)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zdravje360
DB_USERNAME=postgres
DB_PASSWORD=
# Docker example (qss-postgres container): DB_USERNAME=qss DB_PASSWORD=qss_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Staging/production: use redis (see infra/docker-compose.redis.yml for local)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — cache, queues, rate limits; optional locally (database driver works for dev)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Meilisearch — set SCOUT_DRIVER=meilisearch when running search:reindex (see infra/docker-compose.meilisearch.yml)
SCOUT_DRIVER=null
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
SCOUT_QUEUE=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Public Next.js URL (password reset links, moderation emails)
FRONTEND_URL=http://127.0.0.1:3000

# Optional: match NEXT_PUBLIC_PLAUSIBLE_DOMAIN on the web app for admin traffic notes
PLAUSIBLE_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum API tokens (default 30 days). Set null in .env only for local experiments.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# CORS — comma-separated web origins. Local ports are allowed outside production;
# in production this MUST be set or every browser call is blocked.
# CORS_ALLOWED_ORIGINS=https://staging.example.com,https://www.example.com

# Trusted proxies — required in any environment behind a load balancer/CDN, or
# every IP-based rate limit keys on the proxy address instead of the client.
# Not needed locally. "*" trusts the immediate caller.
# TRUSTED_PROXIES=*

# Sentry (optional locally; set in staging/production)
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=local
# SENTRY_TRACES_SAMPLE_RATE=0

# Platform & demo seed users — local/testing/development, or set SEED_LOCAL_DEMO=true
# Never use these defaults in production. Set strong unique passwords via .env.
# SEED_LOCAL_DEMO=true
PLATFORM_ADMIN_EMAIL=admin@zdravje360.test
PLATFORM_ADMIN_PASSWORD=password
PLATFORM_MODERATOR_EMAIL=moderator@zdravje360.test
PLATFORM_MODERATOR_PASSWORD=password
PLATFORM_MEMBER_EMAIL=member@zdravje360.test
PLATFORM_MEMBER_PASSWORD=password
