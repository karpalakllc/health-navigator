APP_NAME=Zdravje360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Public media uploads (logo, avatars) — local: public disk under storage/app/public/media.
# Deployments: MEDIA_DISK=s3 with the AWS_* block below (S3, R2, B2, MinIO) —
# see infra/deploy.md "Media on object storage" and infra/README.md for MinIO.
MEDIA_DISK=public
MEDIA_DIRECTORY=media

# Public Next.js app. FRONTEND_URL: password-reset, verification and moderation
# email links. WEB_PUBLIC_URL: Filament "View on site". https in staging/production.
WEB_PUBLIC_URL=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
# line (default) or json; see config/logging.php.
LOG_FORMAT=line
# Slow-query warnings (ms; 0 disables): one query / all queries of one request or job.
# DB_SLOW_QUERY_MS=500
# DB_SLOW_REQUEST_QUERIES_MS=2000

# PostgreSQL (project standard — not SQLite for local app data)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zdravje360
DB_USERNAME=postgres
DB_PASSWORD=
# Docker example (qss-postgres container): DB_USERNAME=qss DB_PASSWORD=qss_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Staging/production: use redis (see infra/docker-compose.redis.yml for local)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — cache, queues, rate limits; optional locally (database driver works for dev)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Meilisearch — set SCOUT_DRIVER=meilisearch when running search:reindex (see infra/docker-compose.meilisearch.yml)
SCOUT_DRIVER=null
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
# Index updates go through the queue worker (php artisan queue:work), like mail.
SCOUT_QUEUE=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: match NEXT_PUBLIC_PLAUSIBLE_DOMAIN on the web app for admin traffic notes
PLAUSIBLE_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Non-AWS S3-compatible stores only (R2, B2, MinIO).
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Public base media URLs are built from (CDN / bucket public domain).
AWS_URL=
# public = public-read ACL; private for buckets that refuse ACLs (use a bucket policy).
MEDIA_VISIBILITY=public

VITE_APP_NAME="${APP_NAME}"

# Sanctum API tokens (default 30 days). Set null in .env only for local experiments.
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# CORS — comma-separated web origins. localhost:3000 is allowed automatically in
# local/development/testing only; staging and production MUST set this or every
# browser call is blocked.
# CORS_ALLOWED_ORIGINS=https://staging.example.com,https://www.example.com

# Trusted proxies — required in any environment behind a load balancer/CDN, or
# every IP-based rate limit keys on the proxy address instead of the client.
# Not needed locally. List exact CIDR ranges of the API's edge/load balancer; never
# "*", which trusts every hop and lets a client choose its own address.
# TRUSTED_PROXIES=10.0.0.0/8,192.0.2.0/24

# Web tier shared secret (same value on apps/web, server-only). Lets the Next
# server vouch for the visitor's address. Optional locally; required (≥32 chars)
# in staging/production — `openssl rand -hex 32`.
# WEB_TIER_SECRET=

# Sentry (optional locally; set in staging/production)
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=local
# SENTRY_TRACES_SAMPLE_RATE=0

# Failed queued jobs are mailed here (one per job and error type per 15 min); unset sends nothing.
# PLATFORM_ALERT_EMAIL=

# New content reports are mailed (at most every 10 min) to staff who can see the
# report queue; this adds a shared inbox to them. Unset mails staff only.
# REPORT_ALERT_EMAIL=

# New profile corrections and objections are mailed (at most every 10 min) to
# staff who can see the Corrections queue; this adds a shared inbox. Closed
# requests are deleted this many days after closing.
# CORRECTION_ALERT_EMAIL=
# CORRECTION_RETENTION_DAYS=365

# Scheduled source imports (docs/data-import.md): off until the owner turns
# them on. Failed or unusually large runs are mailed to IMPORT_ALERT_EMAIL
# (unset: PLATFORM_ALERT_EMAIL).
# IMPORT_FZOM_SCHEDULE=false
# IMPORT_KOMORA_SCHEDULE=false
# IMPORT_ALERT_EMAIL=
# IMPORT_LARGE_DIFF_RATIO=0.10
# IMPORT_LARGE_DIFF_MIN=25
# Every request to ФЗОМ and the Лекарска комора is sent as
# "<IMPORT_USER_AGENT> (+mailto:<IMPORT_CONTACT>)": set IMPORT_CONTACT to a
# monitored e-mail address before the first real run. KOMORA_EXTRA_HOSTS
# (comma-separated) allows list files on hosts other than the list page's.
# IMPORT_USER_AGENT=Zdravje360-DirectoryImport/1.0
# IMPORT_CONTACT=contact@example.invalid
# KOMORA_EXTRA_HOSTS=
# Import diff summaries, closed review items and lifted suppressions are
# deleted this many days later (import:prune, daily).
# IMPORT_RETENTION_DAYS=365
# Verification engine (docs/verification.md): runs after every import apply
# and nightly. IMPORT_AUTO_PUBLISH_VERIFIED=true publishes the drafts a run
# newly verifies; off, staff publish them with „Објави ги сите верифицирани“.
# Website-only drafts are licence-matched too (KOMORA_MATCH_FALLBACK_SOURCES,
# empty to stop that).
# IMPORT_VERIFY_AFTER_IMPORT=true
# IMPORT_AUTO_PUBLISH_VERIFIED=false
# KOMORA_MATCH_FALLBACK_SOURCES=website

# Platform & demo seed users — local/testing/development, or set SEED_LOCAL_DEMO=true
# Never use these defaults in production. Set strong unique passwords via .env.
# SEED_LOCAL_DEMO=true
PLATFORM_ADMIN_EMAIL=admin@zdravje360.test
PLATFORM_ADMIN_PASSWORD=password
PLATFORM_MODERATOR_EMAIL=moderator@zdravje360.test
PLATFORM_MODERATOR_PASSWORD=password
PLATFORM_MEMBER_EMAIL=member@zdravje360.test
PLATFORM_MEMBER_PASSWORD=password
