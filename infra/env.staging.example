# Staging environment reference (copy values to host dashboards — do not commit secrets)

# --- API (apps/api) ---
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://api-staging.example.com
DB_CONNECTION=pgsql
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=
SCOUT_QUEUE=true
CORS_ALLOWED_ORIGINS=https://staging.example.com
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=staging
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Do NOT set PLATFORM_* seed passwords in staging unless intentionally re-seeding local-style data

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=https://api-staging.example.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
SENTRY_ENVIRONMENT=staging
