# Production environment reference (copy values to host dashboards — do not commit secrets)

# --- API (apps/api) ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
DB_CONNECTION=pgsql
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=
SCOUT_QUEUE=true
CORS_ALLOWED_ORIGINS=https://www.example.com
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# First deploy on empty DB: php artisan platform:bootstrap
# Ongoing deploys: php artisan migrate --force

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
