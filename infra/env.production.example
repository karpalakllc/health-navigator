# Production environment reference (copy values to host dashboards — do not commit secrets)
#
# `php artisan platform:preflight` checks the API half of this file against the
# running configuration and fails the deploy on anything unsafe — run it before
# `migrate` (see deploy.md).

# --- API (apps/api) ---
APP_NAME=Zdravje360
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com

# Generate ONCE per environment with `php artisan key:generate --show` and store
# it in the host's secret manager. Never generate it during a build or deploy
# step (rotating it logs everyone out and breaks every encrypted value), and
# never reuse the production key in staging.
APP_KEY=

# Logs to stdout/stderr so the PaaS log stream captures them; the default
# "stack" writes to storage/logs, which an ephemeral filesystem throws away.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Public Next.js origin, no trailing slash. Password-reset, verification and
# moderation emails link here; WEB_PUBLIC_URL feeds Filament's "View on site".
FRONTEND_URL=https://www.example.com
WEB_PUBLIC_URL=https://www.example.com

# Required behind a TLS-terminating edge, and intentionally unset by default.
# Without it every $request->ip() rate limiter keys on the load balancer address
# and a few failed logins lock out all users.
#
# List the exact CIDR ranges of the API's own edge/load balancer. The web tier
# does NOT belong here: it vouches for the visitor's address with WEB_TIER_SECRET
# (below), which works even for web hosts with dynamic egress. NEVER use "*", "**"
# or 0.0.0.0/0: Laravel then trusts every hop in X-Forwarded-For and takes the
# leftmost — client-supplied — entry as $request->ip(), so any caller picks its
# own rate-limit bucket. That holds even when the origin is reachable only
# through the edge, because the edge appends to whatever the client sent.
TRUSTED_PROXIES=

# Which header carries the visitor's address. Leave unset to use the rightmost
# x-forwarded-for entry, which is correct behind both appending edges (nginx,
# Cloudflare) and overwriting ones (Vercel). Set it only to a header your edge
# is known to OVERWRITE — e.g. cf-connecting-ip. Naming a header the edge merely
# passes through lets any caller pick its own rate-limit bucket.
#
# Set it to "none" if `next start` is exposed to the internet with no proxy in
# front: the caller then writes the whole x-forwarded-for header itself.
#
# This is read by the web tier (apps/web), not the API. Without correct client
# IP forwarding the per-address login limits meter everyone into one bucket —
# see apps/web/src/lib/api/client-ip.ts.
CLIENT_IP_HEADER=

# Shared secret that lets the web tier vouch for the visitor's address
# (X-Web-Tier-Auth + X-Client-IP, checked by TrustWebTierClientIp). Set the SAME
# value on the API and on the web server — server-only on the web side, never
# NEXT_PUBLIC_. Generate once per environment: `openssl rand -hex 32` (min 32
# chars; shorter values are ignored). Store it in the host's secret manager.
# Rotate by changing both tiers; during a mismatch the web tier is metered as one
# client (fails safe — no bypass). platform:preflight fails when it is missing.
WEB_TIER_SECRET=

# Object storage is strongly recommended: on an ephemeral PaaS filesystem the
# "public" disk loses every uploaded logo and avatar on redeploy. If you do keep
# "public" on a persistent volume, run `php artisan storage:link` once. With
# object storage, the web CSP img-src and next.config images must also allow the
# media host (see deploy.md).
MEDIA_DISK=public

# Created by `php artisan platform:bootstrap` on a fresh database. Use a real
# mailbox you control — preflight rejects the .test development default.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Never true outside development: it seeds demo staff/member accounts with weak
# passwords. Preflight fails if it is set.
SEED_LOCAL_DEMO=false

DB_CONNECTION=pgsql
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Rate limits and the login lockout live in the cache, so it must be shared by
# every API process: redis (or database) — never file or array.
CACHE_STORE=redis
# Never "sync": mail and search indexing would run inside the request.
QUEUE_CONNECTION=redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=database
# The Filament admin session cookie is only sent over HTTPS.
SESSION_SECURE_COOKIE=true

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=
SCOUT_QUEUE=true

# Comma-separated web origins; no localhost entries.
CORS_ALLOWED_ORIGINS=https://www.example.com

# API tokens expire after 30 days. The prefix makes leaked tokens recognisable
# to secret scanners (GitHub secret scanning and similar).
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
SANCTUM_TOKEN_PREFIX=z360_

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# Mail — REQUIRED. Password reset, email verification, the welcome mail and the
# UGC moderation lifecycle all depend on it. Mail sent through the queue fails
# silently into failed_jobs when the transport is wrong, so users simply never
# receive it. Use a real ESP (SES, Postmark, Mailgun) and a domain you control.
#
# MAIL_SCHEME is the Symfony Mailer scheme, not the TLS mode: "smtp" (port 587,
# upgraded with STARTTLS automatically) or "smtps" (port 465, implicit TLS).
# "tls" and "ssl" are rejected by Symfony and every send fails.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Zdravje360

# Every deploy: php artisan platform:preflight (must pass), then
# first deploy on empty DB: php artisan platform:bootstrap
# ongoing deploys:          php artisan migrate --force

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=https://api.example.com
# Required: canonical URLs, OpenGraph, robots.txt and sitemap.xml all need it.
# Must be present at BUILD time — it is inlined into the bundle.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional, server-only, read at RUNTIME (no rebuild needed): extra origins the
# web tier's /api/** write handlers accept besides NEXT_PUBLIC_SITE_URL's — e.g.
# the apex next to www, or a staging alias. Comma-separated full origins, no
# paths. On Vercel, VERCEL_URL and VERCEL_BRANCH_URL are accepted automatically.
# Without it, sign-in, logout and every form from another origin answer 403.
ALLOWED_ORIGINS=

# Analytics (optional). Setting the domain enables Plausible. For a self-hosted
# instance set BOTH of the following to the same origin: the script is loaded
# from SCRIPT_URL, and the CSP connect-src allows the beacon to HOST — if they
# disagree the script loads but every event is blocked.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.example.com/js/script.js
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.example.com

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
# Build-time only: lets the build upload source maps so production stack traces
# resolve to real files. Keep SENTRY_AUTH_TOKEN secret (build env, not runtime).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
