# Production environment reference (copy values to host dashboards — do not commit secrets)

# --- API (apps/api) ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com

# Required behind a TLS-terminating edge, and intentionally unset by default.
# Without it every $request->ip() rate limiter keys on the load balancer address
# and a few failed logins lock out all users. "*" trusts the immediate caller and
# is correct ONLY when the app port is reachable solely through the edge — if the
# origin is directly reachable, "*" lets a client spoof X-Forwarded-For and bypass
# every IP limit. Prefer the host's published CIDR ranges.
TRUSTED_PROXIES=

# Object storage is strongly recommended: on an ephemeral PaaS filesystem the
# default "public" disk loses every uploaded logo and avatar on redeploy.
MEDIA_DISK=public

# Created by `php artisan platform:bootstrap` on a fresh database.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
DB_CONNECTION=pgsql
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=
MEILISEARCH_KEY=
SCOUT_QUEUE=true
CORS_ALLOWED_ORIGINS=https://www.example.com
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# Mail — REQUIRED. Password reset, the welcome mail and the whole UGC
# moderation lifecycle are queued mailables; with no transport configured they
# fail silently into failed_jobs and users cannot recover their accounts.
# Use a real ESP (SES, Postmark, Mailgun) and a domain you control.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Zdravje360

# First deploy on empty DB: php artisan platform:bootstrap
# Ongoing deploys: php artisan migrate --force

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=https://api.example.com
# Required: canonical URLs, OpenGraph, robots.txt and sitemap.xml all need it.
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
